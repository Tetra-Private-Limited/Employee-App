DATABASE_URL=postgresql://user:password@localhost:5432/employee_tracker
JWT_ACCESS_SECRET=your-access-secret-key-here
JWT_REFRESH_SECRET=your-refresh-secret-key-here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
PORT=3001
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development
# IANA timezone the organization operates in (e.g. Asia/Dhaka). Determines
# attendance day boundaries and the late-arrival cutoff, independent of the
# server host's own timezone.
ORG_TIMEZONE=UTC
